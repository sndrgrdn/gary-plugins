{
  "$schema": "./manifest.schema.json",
  "schemaVersion": 1,
  "id": "sndrgrdn.theme",
  "name": "Theme",
  "version": "0.2.1",
  "kinds": ["service", "menu"],
  "entryPoints": { "service": "service.ts", "menu": "menu.ts" },
