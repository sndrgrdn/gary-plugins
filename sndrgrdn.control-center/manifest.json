{
  "$schema": "./manifest.schema.json",
  "schemaVersion": 1,
  "id": "sndrgrdn.control-center",
  "name": "Control Center",
  "version": "0.1.0",
  "kinds": ["bar-widget", "menu", "overlay"],
  "entryPoints": { "bar-widget": "widget.tsx", "menu": "menu.tsx", "overlay": "osd.tsx" },
  "bar": "right",
  "surfaces": { "overlay": ["osd"] },
  "mediakeys": { "overlay": ["volume-up", "volume-down", "mute", "brightness-up", "brightness-down"] },
  "subscribes": { "menu": ["wifi", "bluetooth", "focus", "audio", "brightness"], "overlay": ["audio", "brightness"] },
  "uses": ["wifi", "bluetooth", "audio", "brightness"]
}
